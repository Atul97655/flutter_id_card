migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Firebase / signing credentials - never commit these.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
android/key.properties
*.keystore
*.jks
firebase-debug.log
firestore-debug.log

# Claude Code's own local session/config directory - not part of the app.
.claude/

# Temporary emulator screenshots and scratch files
emulator_*.png
/scratch/


# Firebase rules-test harness (emulator deps and local emulator state)
firebase/rules-tests/node_modules/
firebase/rules-tests/package-lock.json
firebase/**/*.log
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log

# Release signing - private key material and its passwords. Never commit.
android/key.properties
*.jks
*.keystore
