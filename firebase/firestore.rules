rules_version = '2';

// Firestore security rules for the School ID Card System.
//
// The client-side role check in the app is a UI convenience only. THESE rules
// are what actually protect the data - anyone can talk to Firestore with a
// stolen ID token and a curl command.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Data model these rules assume:
//   users/{uid}                      role: "Admin" | "Teacher" | "School",
//                                    schoolId, active
//   schools/{schoolId}               name, cardSizeId, enabledFields, colours...
//   schools/{schoolId}/entries/{id}  one student record
//   chats/{chatId}                   Phase 5 messaging
//   chats/{chatId}/messages/{id}
//
// NOTE: the users document MUST be keyed by the Firebase Auth UID. A document
// with an auto-generated ID cannot be found by these rules, and every request
// from that account will be denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers -----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // A deactivated account keeps its Auth credentials but loses all access,
    // so an admin can cut someone off without deleting their history.
    function isActive() {
      return userExists() && userDoc().get('active', true) == true;
    }

    function isAdmin() {
      return isActive() && userDoc().role == 'Admin';
    }

    // Teacher and School are the same data scope - both are tied to exactly
    // one schoolId and see only that school. The split is organisational (a
    // School account is the office, a Teacher account is one person in it),
    // so every rule below treats them identically. Anything that is NOT
    // 'Admin' is an operator, which keeps an unrecognised future role at the
    // lower privilege rather than accidentally granting admin.
    function isOperator() {
      return isActive() && userDoc().role != 'Admin';
    }

    function operatorSchoolId() {
      return userDoc().get('schoolId', '');
    }

    function belongsToSchool(schoolId) {
      return isOperator() && operatorSchoolId() == schoolId;
    }

    // --- section scope -------------------------------------------------
    //
    // An assignment narrows a teacher from a whole school to one class and
    // section. It lives on the user document and only an admin can write it
    // (see the `users` rules below), which is what makes it a boundary
    // rather than a preference.
    //
    // Note what is NOT here: nothing grants access. An assignment can only
    // ever take access away from someone who already had it through
    // `belongsToSchool`. A teacher with an assignment but no `schoolId` -
    // which is every teacher between scanning a QR code and being approved -
    // reads nothing at all, because the gate they have to pass first is
    // still `schoolId`, and only an admin can write that.
    function assignment() {
      return userDoc().get('assignment', {});
    }

    // A scope exists only when the office has actually set one. An empty or
    // pending assignment deliberately means "no narrowing", so that
    // upgrading an existing installation cannot silently hide a teacher's
    // own students from them on the day this ships.
    function hasSectionScope() {
      return assignment().get('status', '') == 'active'
        && assignment().get('classLevel', '') != ''
        && assignment().get('division', '') != '';
    }

    // Whether a given entry falls inside the caller's section.
    //
    // Reading this on a LIST is stricter than it looks: Firestore refuses the
    // whole query unless every document it returns satisfies the rule, so a
    // scoped teacher must put the matching `where` clauses on their query or
    // get nothing. That is intentional - it forces the client to be explicit
    // about the scope rather than fetching everything and filtering in the
    // widget, which would leak the data it was meant to be hiding.
    function inSectionScope(data) {
      return !hasSectionScope()
        || (data.get('studentClass', '') == assignment().get('classLevel', '')
            && data.get('division', '') == assignment().get('division', ''));
    }

    // --- users -------------------------------------------------------

    match /users/{uid} {
      // You can read your own profile; admins can read anyone's.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Only admins delete accounts.
      allow delete: if isAdmin();

      // Creation is an admin's job, with one exception: a teacher signing
      // themselves up before scanning their school's QR code.
      //
      // Self-registration exists because the alternative does not work. The
      // panel cannot mint an account - creating a Firebase Auth user from the
      // browser SDK signs the admin out of their own session, and doing it
      // properly needs the Admin SDK on a server this project does not have.
      //
      // The trade is that anyone can hold an identity in this project. That
      // is safe only because of what a fresh account is forbidden from
      // writing onto itself:
      //
      //   role      - pinned to 'Teacher'. Without this the first thing a
      //               stranger would write is role: 'Admin'.
      //   schoolId  - must be ABSENT. This is the load-bearing one. Every
      //               read rule in this file reaches a school through
      //               `belongsToSchool`, which compares against this field,
      //               so an account without it can read nothing anywhere.
      //               Only an admin can add it, and that is precisely what
      //               approving a pending join means.
      //   assignment- must be ABSENT, for the same reason.
      //
      // So a self-registered account is an identity and nothing else until
      // someone in the office acts.
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == 'Teacher'
          && request.resource.data.get('active', true) == true
          && !('schoolId' in request.resource.data)
          && !('assignment' in request.resource.data)
        );

      // Admins may update anything. A user may update only their own
      // lastLoginDate - nothing else, and specifically not role or schoolId.
      allow update: if isAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['lastLoginDate'])
        );
    }

    // --- schools -----------------------------------------------------

    match /schools/{schoolId} {
      // An operator reads only their own school's settings; admins read all.
      allow read: if isAdmin() || belongsToSchool(schoolId);

      // Card size, field toggles and branding are admin-controlled. An
      // operator must not be able to switch a required field off.
      allow create, update, delete: if isAdmin();

      // --- pending joins ---------------------------------------------
      //
      // A teacher who has scanned this school's code and is waiting for the
      // office to give them a class. Keyed by their uid so one teacher
      // cannot queue up twice, and so the record is trivially findable when
      // the office acts on it.
      //
      // The teacher may read their own request - that is the whole of screen
      // 18's "Check again" - and may create it once. They may not update it
      // or delete it: a request that could rewrite its own status is not a
      // request, and self-approval is the exact failure this flow exists to
      // prevent.
      match /joinRequests/{uid} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.schoolId == schoolId
          && request.resource.data.status == 'pending';

        // Approving, declining and clearing are all the office's.
        allow update, delete: if isAdmin();
      }

      // --- student entries -------------------------------------------

      match /entries/{entryId} {
        // A section assignment narrows this; no assignment leaves it as it
        // was. See `inSectionScope` for why a scoped LIST needs matching
        // `where` clauses on the client query.
        allow read: if isAdmin()
          || (belongsToSchool(schoolId) && inSectionScope(resource.data));

        // The review decision is the admin's alone. An operator approving
        // their own submission would make the whole review step decorative,
        // so these four fields are off-limits to them.
        function reviewFieldsUnchanged() {
          return !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['approvalStatus', 'rejectionReason',
                     'reviewedBy', 'reviewedAt']);
        }

        function isUppercaseOrEmpty(val) {
          return val == null || (val is string && !val.matches('.*[a-z].*'));
        }

        function hasValidTextCapitalization() {
          return (!('name' in request.resource.data) || isUppercaseOrEmpty(request.resource.data.name))
              && (!('fatherName' in request.resource.data) || isUppercaseOrEmpty(request.resource.data.fatherName))
              && (!('studentClass' in request.resource.data) || isUppercaseOrEmpty(request.resource.data.studentClass))
              && (!('division' in request.resource.data) || isUppercaseOrEmpty(request.resource.data.division))
              && (!('rollNumber' in request.resource.data) || isUppercaseOrEmpty(request.resource.data.rollNumber))
              && (!('address' in request.resource.data) || isUppercaseOrEmpty(request.resource.data.address));
        }

        // A new entry must start unreviewed. Without this an operator could
        // create a record already marked approved and skip review entirely.
        // Also strictly validates that all ID-card text fields are UPPERCASE.
        allow create: if (isAdmin() || belongsToSchool(schoolId))
          && request.resource.data.schoolId == schoolId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && hasValidTextCapitalization()
          && inSectionScope(request.resource.data)
          && (isAdmin()
              || !('submittedByUid' in request.resource.data)
              || request.resource.data.submittedByUid == request.auth.uid)
          && (isAdmin()
              || !('approvalStatus' in request.resource.data)
              || request.resource.data.approvalStatus == 'pending');

        // Admins may change anything, including the review decision.
        // Operators may correct the student's details but never the review.
        // Both the before and after states are checked against the scope. A
        // teacher must not be able to edit a card out of their own section,
        // nor reach into a section they were never given.
        allow update: if (isAdmin()
                          || (belongsToSchool(schoolId)
                              && reviewFieldsUnchanged()
                              && inSectionScope(resource.data)
                              && inSectionScope(request.resource.data)))
          && request.resource.data.schoolId == schoolId
          && hasValidTextCapitalization();

        // Deletion is admin-only: an operator deleting a synced record would
        // silently remove a student from the print run.
        allow delete: if isAdmin();

        // --- the student's photo, carried inside Firestore ---------
        //
        // Cloud Storage is not provisioned on this project and cannot be
        // without moving it to the Blaze plan, so the photo travels as base64
        // in its own document instead. It is kept OUT of the entry document
        // because the admin panel lists every submission across every school
        // in one query - a full photo per entry would mean downloading tens of
        // megabytes to render a table of names. The entry carries only a
        // thumbnail; this is the full frame, fetched when something actually
        // renders or prints it.
        //
        // Same audience as the entry it belongs to: whoever may read the
        // student's details may see their picture, and nobody else.
        match /media/{mediaId} {
          // The section scope has to be re-checked here against the entry
          // this photo belongs to. A media document carries no class or
          // division of its own, so without this lookup a teacher scoped to
          // 10-A who knew an entry id could still fetch the photograph of a
          // child in 10-B - which is the most sensitive thing in the whole
          // database to get wrong.
          //
          // This costs one extra document read per evaluation. That is worth
          // paying: the alternative is denormalising class and division onto
          // every media document, where they would be a second copy that can
          // drift out of step with the entry.
          function parentEntry() {
            return get(/databases/$(database)/documents/schools/$(schoolId)/entries/$(entryId)).data;
          }

          allow read: if isAdmin()
            || (belongsToSchool(schoolId) && inSectionScope(parentEntry()));

          // The size cap is the point of writing this rule out rather than
          // reusing the entry rule. A document may hold just under 1 MiB, and
          // an unbounded base64 field is the one field here a client could use
          // to push a document to that limit - at which point the entry stops
          // being writable at all and the student's record is stuck. 800000
          // leaves headroom above what the encoder actually produces (tens of
          // KB) while still refusing anything pathological.
          allow create, update: if (isAdmin() || belongsToSchool(schoolId))
            && request.resource.data.data is string
            && request.resource.data.data.size() < 800000;

          allow delete: if isAdmin();
        }
      }
    }

    // --- entries, as a collection group -------------------------------
    //
    // The admin panel reads every submission across every school in one query
    // (`collectionGroup('entries')`) rather than opening one subscription per
    // school. A collection group query does NOT match the nested
    // `/schools/{id}/entries/{id}` rule above - Firestore requires a rule
    // whose path matches the collection group itself, or the whole query is
    // refused with "Missing or insufficient permissions" even for an admin.
    //
    // Deliberately admin-only. The query spans every school at once, which is
    // exactly what an operator must never be able to do; operators read their
    // own school through the scoped path above, which still applies.
    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
    }

    // --- QR join codes -------------------------------------------------
    //
    // One document per live code, keyed BY the token itself, holding the
    // school's id and its name and nothing else.
    //
    // Keyed by the token on purpose. The alternative - storing the token on
    // the school and querying `where('qrToken', '==', x)` - would require
    // read access to the schools collection to run the query, which is the
    // access this whole flow exists to withhold. Here the token is the
    // document id, so the only way to read one is to already have it.
    //
    // What possessing a code buys you is therefore exactly one thing: the
    // name of the school you are about to ask to join. That is what screen 17
    // has to show before the teacher confirms, and it is the least that can
    // be shown to make that screen honest.
    //
    // `list` is admin-only, and that asymmetry is the point. Any signed-in
    // account may `get` a code it already holds; only the office may
    // enumerate them. Without the split, one leaked teacher login would be a
    // way into every school in the installation at once. `read` would have
    // granted both operations, which is why they are spelled out separately.
    //
    // The office needs `list` because the QR page (A8) has to find whichever
    // code a school currently holds, and the alternative - storing the token
    // on the school document - would put it in reach of every account in
    // that school rather than just the admin.
    //
    // Rotation (screen A8) is deleting this document and writing a new one
    // under a new token. Every printed copy of the old code stops resolving
    // immediately. Teachers who already joined are untouched, because their
    // access comes from `users/{uid}.schoolId` and never references a token.
    match /joinCodes/{token} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // --- pending joins, as a collection group --------------------------
    //
    // The office's Pending Joins page (A10) reads across every school at
    // once, and as with entries a collection group query does not match the
    // nested rule. Admin-only, for the same reason.
    match /{path=**}/joinRequests/{requestId} {
      allow read: if isAdmin();
    }

    // --- installation settings ---------------------------------------
    //
    // One document describing the installation rather than any one school -
    // currently just whether this office prints cards at all.
    //
    // Readable by every active account, because the app and the panel both
    // need to know which features are part of this installation before they
    // can decide what to show. Writable by an admin alone: a feature switch
    // an operator could flip is a feature switch that flips by accident.
    match /config/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // --- messaging (Phase 5) -----------------------------------------

    match /chats/{chatId} {
      function isMember() {
        return isActive()
          && request.auth.uid in resource.data.get('members', []);
      }

      // Membership is stored on the chat document as an array of UIDs.
      allow read: if isActive() && (isAdmin() || isMember());

      // Only admins open a conversation. This is the hub-and-spoke rule: a
      // teacher cannot create a chat with anyone, so teacher-to-teacher
      // messaging is impossible at the database level, not just hidden in the
      // UI.
      allow create: if isAdmin();
      allow delete: if isAdmin();

      // An admin may change anything about the conversation.
      //
      // A member may change ONLY the activity fields that sending or reading a
      // message writes. Without this a teacher could not send a message or
      // clear their unread badge at all: both go through a batched update on
      // this document, and an admin-only update rule fails the whole batch.
      // `members` is deliberately not in the list - a teacher must never be
      // able to add themselves to another school's conversation.
      allow update: if isAdmin()
        || (
          isMember()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId',
                         'unreadFor'])
        );

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        function isChatMember() {
          return isAdmin()
            || request.auth.uid in parentChat().get('members', []);
        }

        // Matches `ChatKind.broadcast.name` as written by the client.
        function isBroadcast() {
          return parentChat().get('kind', 'direct') == 'broadcast';
        }

        allow read: if isActive() && isChatMember();

        // senderId is pinned to the caller so nobody can post as someone else.
        // A broadcast is an announcement, not a thread - only the admin may
        // post into one. The chat screen also hides the composer, but that is
        // decoration; this is the control.
        allow create: if isActive()
          && isChatMember()
          && request.resource.data.senderId == request.auth.uid
          && (isAdmin() || !isBroadcast());

        // Messages are immutable except for read receipts.
        allow update: if isActive()
          && isChatMember()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['readBy']);

        allow delete: if isAdmin();

        // --- the attachment itself, carried inside Firestore ------
        //
        // Same reason as a student's photo: Cloud Storage is not provisioned
        // on this project, so a picked file travels as base64 in its own
        // document. It is kept OUT of the message because a conversation
        // loads every message at once - a full image on each would mean
        // downloading the whole thread's attachments to read one line of
        // text. The message carries a thumbnail; this is the file.
        //
        // Membership is the only gate, exactly as for the message it belongs
        // to: whoever may read the message may open what was attached to it,
        // and nobody else. A broadcast is admin-post-only, and that is
        // enforced on the message above - an attachment cannot exist without
        // the message that points at it.
        match /media/{mediaId} {
          allow read: if isActive() && isChatMember();

          // The size cap is why this rule is written out rather than
          // inherited. An unbounded base64 field is the one field a client
          // could use to push a document to Firestore's 1 MiB limit, and a
          // document at that limit can no longer be written at all.
          allow create, update: if isActive()
            && isChatMember()
            && (isAdmin() || !isBroadcast())
            && request.resource.data.data is string
            && request.resource.data.data.size() < 800000;

          allow delete: if isAdmin();
        }
      }
    }

    // Anything not matched above is denied. Do not add a catch-all.
  }
}
