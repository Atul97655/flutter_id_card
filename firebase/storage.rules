rules_version = '2';

// Firebase Storage rules for student photos, school branding and chat files.
//
// Deploy with:  firebase deploy --only storage
// (Deploying rules is free - it does NOT require the Blaze plan.)
//
// Paths:
//   schools/{schoolId}/photos/{entryId}.png   student photo
//   schools/{schoolId}/logo.png               school logo / signature
//   chats/{chatId}/{uuid}_{fileName}          chat attachment

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn() && userDoc().get('active', true) == true;
    }

    function isAdmin() {
      return isActive() && userDoc().role == 'Admin';
    }

    function belongsToSchool(schoolId) {
      return isActive() && userDoc().get('schoolId', '') == schoolId;
    }

    // A processed card photo is 360 x 450 px - a few hundred KB at most.
    // The cap stops a mis-wired client from uploading a raw 12 MP capture and
    // costing the organisation storage and bandwidth.
    function isReasonablePhoto() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /schools/{schoolId}/photos/{fileName} {
      allow read: if isAdmin() || belongsToSchool(schoolId);
      allow write: if (isAdmin() || belongsToSchool(schoolId)) && isReasonablePhoto();
      allow delete: if isAdmin();
    }

    match /schools/{schoolId}/{fileName} {
      allow read: if isAdmin() || belongsToSchool(schoolId);
      // Branding assets are admin-controlled.
      allow write, delete: if isAdmin() && isReasonablePhoto();
    }

    // --- chat attachments -------------------------------------------------
    //
    // Membership is read from the conversation document in Firestore. An
    // earlier version of these rules allowed any active user to read and write
    // here and leaned on "unguessable" paths, which is not a control at all:
    // a chat id is visible to every member and is stored in plain text in
    // Firestore, so any teacher could have read another school's attachments.
    //
    // The plan of action makes this non-negotiable - "a teacher can read and
    // write messages only in their own conversation" - so it is enforced the
    // same way the Firestore rules enforce it, against the members array.
    //
    // Cost: one Firestore read per Storage operation. That is the price of
    // actually checking, and attachment traffic is low.
    function chatMembers(chatId) {
      return firestore.get(/databases/(default)/documents/chats/$(chatId))
                      .data.get('members', []);
    }

    function isChatMember(chatId) {
      return isActive()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && (isAdmin() || request.auth.uid in chatMembers(chatId));
    }

    // Attachments are photos and paperwork. An allowlist keeps an executable
    // out of a bucket whose download URLs get pasted into chats; widen it here
    // if the office needs another document type.
    function isAllowedAttachment() {
      return request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType ==
               'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType ==
               'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        );
    }

    match /chats/{chatId}/{fileName} {
      allow read: if isChatMember(chatId);
      allow write: if isChatMember(chatId) && isAllowedAttachment();
      allow delete: if isAdmin();
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
